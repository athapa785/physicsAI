{
  "name": "Python 3",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "src/App.jsx"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "[ -f requirements.txt ] && pip3 install --user -r requirements.txt; npm install; echo '✅ Physics Atlas dependencies installed'",
  "postAttachCommand": {
    "server": "uvicorn backend.main:app --host 0.0.0.0 --port 8000 & npm run dev -- --host 0.0.0.0"
  },
  "portsAttributes": {
    "5173": {
      "label": "Physics Atlas",
      "onAutoForward": "openPreview"
    },
    "8000": {
      "label": "Physics Atlas API",
      "onAutoForward": "silent"
    }
  },
  "forwardPorts": [
    5173,
    8000
  ]
}
